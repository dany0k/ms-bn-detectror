{
  "name": "obvious-bottleneck",
  "description": "Явный bottleneck: latency взлетает в 10 раз при RPS > 30",
  "start_time": "2025-01-20T12:00:00+00:00",

  "load_steps": [
    {"rps": 10, "duration_seconds": 60},
    {"rps": 20, "duration_seconds": 60},
    {"rps": 30, "duration_seconds": 60},
    {"rps": 50, "duration_seconds": 90},
    {"rps": 70, "duration_seconds": 90},
    {"rps": 40, "duration_seconds": 60},
    {"rps": 20, "duration_seconds": 60}
  ],

  "services": [
    {
      "src_service": "api",
      "src_route": "/request",
      "dst_service": "fast-cache",
      "dst_route": "/get",
      "base_latency": 3.0,
      "latency_noise": 0.5
    },
    {
      "src_service": "api",
      "src_route": "/request",
      "dst_service": "slow-db",
      "dst_route": "/query",
      "base_latency": 10.0,
      "latency_noise": 1.0,
      "bottleneck": {
        "rps_threshold": 30,
        "latency_multiplier": 5.0,
        "latency_per_rps": 3.0
      }
    }
  ]
}