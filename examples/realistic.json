{
  "name": "realistic-microservices",
  "description": "Реалистичная симуляция: плавный рост RPS до 120 с bottleneck на БД после 90 RPS",
  "start_time": "2025-01-20T10:00:00+00:00",
  "duration_seconds": 600,
  "base_rps": 30.0,
  "rps_noise_stddev": 0.08,
  "daily_pattern": false,
  "daily_peak_hour": 14,
  "daily_amplitude": 0.3,
  "rps_trend_per_hour": 60.0,
  "load_steps": [
    {
      "rps": 30,
      "duration_seconds": 60,
      "ramp_seconds": 10
    },
    {
      "rps": 50,
      "duration_seconds": 60,
      "ramp_seconds": 20
    },
    {
      "rps": 70,
      "duration_seconds": 60,
      "ramp_seconds": 20
    },
    {
      "rps": 90,
      "duration_seconds": 60,
      "ramp_seconds": 20
    },
    {
      "rps": 100,
      "duration_seconds": 80,
      "ramp_seconds": 20
    },
    {
      "rps": 110,
      "duration_seconds": 80,
      "ramp_seconds": 20
    },
    {
      "rps": 120,
      "duration_seconds": 100,
      "ramp_seconds": 20
    }
  ],
  "services": [
    {
      "src_service": "api-gateway",
      "src_route": "/v1/data",
      "dst_service": "redis",
      "dst_route": "/cache",
      "base_latency": 2.0,
      "noise_type": "lognormal",
      "noise_stddev": 0.15,
      "spike_probability": 0.005,
      "spike_multiplier": 3.0,
      "periodic_anomaly_interval": 0,
      "periodic_anomaly_duration": 2,
      "periodic_anomaly_multiplier": 3.0,
      "bottleneck_rps": 0,
      "bottleneck_multiplier": 2.0,
      "bottleneck_per_rps": 1.0,
      "depends_on": null,
      "dependency_factor": 0.3
    },
    {
      "src_service": "api-gateway",
      "src_route": "/v1/data",
      "dst_service": "postgres",
      "dst_route": "/query",
      "base_latency": 12.0,
      "noise_type": "lognormal",
      "noise_stddev": 0.25,
      "spike_probability": 0.02,
      "spike_multiplier": 4.0,
      "periodic_anomaly_interval": 120,
      "periodic_anomaly_duration": 3,
      "periodic_anomaly_multiplier": 2.5,
      "bottleneck_rps": 90,
      "bottleneck_multiplier": 3.0,
      "bottleneck_per_rps": 2.0,
      "depends_on": null,
      "dependency_factor": 0.3
    },
    {
      "src_service": "api-gateway",
      "src_route": "/v1/external",
      "dst_service": "external-api",
      "dst_route": "/fetch",
      "base_latency": 50.0,
      "noise_type": "lognormal",
      "noise_stddev": 0.4,
      "spike_probability": 0.05,
      "spike_multiplier": 3.0,
      "periodic_anomaly_interval": 0,
      "periodic_anomaly_duration": 2,
      "periodic_anomaly_multiplier": 3.0,
      "bottleneck_rps": 0,
      "bottleneck_multiplier": 2.0,
      "bottleneck_per_rps": 1.0,
      "depends_on": "postgres/query",
      "dependency_factor": 0.2
    }
  ]
}