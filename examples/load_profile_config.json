{
  "name": "bottleneck-test-scenario",
  "description": "Тестовый сценарий: нагрузка растёт ступенями, db-service деградирует при RPS > 40",
  "start_time": "2025-01-15T10:00:00+00:00",
  
  "load_steps": [
    {
      "rps": 10,
      "duration_seconds": 30,
      "ramp_seconds": 5,
      "_comment": "Разогрев: 10 RPS на 30 секунд"
    },
    {
      "rps": 30,
      "duration_seconds": 60,
      "ramp_seconds": 10,
      "_comment": "Средняя нагрузка: 30 RPS на 60 секунд"
    },
    {
      "rps": 50,
      "duration_seconds": 60,
      "ramp_seconds": 10,
      "_comment": "Высокая нагрузка: 50 RPS - здесь начнётся bottleneck"
    },
    {
      "rps": 70,
      "duration_seconds": 60,
      "ramp_seconds": 10,
      "_comment": "Пиковая нагрузка: 70 RPS - сильный bottleneck"
    },
    {
      "rps": 50,
      "duration_seconds": 30,
      "ramp_seconds": 5,
      "_comment": "Спад нагрузки"
    },
    {
      "rps": 30,
      "duration_seconds": 30,
      "ramp_seconds": 5,
      "_comment": "Возврат к норме"
    }
  ],
  
  "services": [
    {
      "src_service": "api-gateway",
      "src_route": "/v1/users",
      "dst_service": "cache-service",
      "dst_route": "/get",
      "base_latency": 5.0,
      "latency_noise": 0.5,
      "_comment": "Кэш - всегда быстрый, без bottleneck"
    },
    {
      "src_service": "api-gateway",
      "src_route": "/v1/users",
      "dst_service": "db-service",
      "dst_route": "/query",
      "base_latency": 15.0,
      "latency_noise": 2.0,
      "bottleneck": {
        "rps_threshold": 40,
        "latency_multiplier": 2.0,
        "latency_per_rps": 1.5,
        "_comment": "При RPS > 40: latency = 15ms * 2 + (rps-40) * 1.5ms"
      }
    },
    {
      "src_service": "api-gateway",
      "src_route": "/v1/orders",
      "dst_service": "inventory-service",
      "dst_route": "/check",
      "base_latency": 20.0,
      "latency_noise": 3.0,
      "bottleneck": {
        "rps_threshold": 60,
        "latency_multiplier": 1.5,
        "latency_per_rps": 0.8,
        "_comment": "Мягкий bottleneck при RPS > 60"
      }
    }
  ]
}
